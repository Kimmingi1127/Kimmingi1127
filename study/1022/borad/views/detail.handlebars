<h1>{{title}}</h1>
<h2 clss = "text-xl">제목 입니다.</h2>

<div>
    작성자 : <b> 작성자 이름 </b>
</div>

<div>
    조회수 : 999 | 작성 일시 : 2025-10-22 12:00:00
    <button onclick = "modifyPost()"> 수정 </button>
    <button onclick = "deletePost()"> 삭제 </button>
</div>

<div>
    <pre>본문 입니다. 하이하이</pre>
</div>

<section>
    <div>
        <h3> 3개의 댓글이 있습니다.</h3>
    </div>

    <form method="post" action="/write-comment">
        <div>
            <div>
                <input type = "text" name = "name" placeholder="이름">
                <input type = "text" name = "password" placeholder="비밀번호">
            </div>
            <div>
                <textarea cols="40" rows = "3" name="comment" placeholder="댓글을 입력하세요."></textarea>
                <br /><br /><button>댓글 쓰기</button>
            </div>
        </div>
    </form>
</section>

<section>
    <div>
        <div>
            작성자: <b>댓글 작성자</b>
        </div>
        <div>
            작성 일시: 2025-10-22 12:00:00
            <button onclick = "deleteComment()"> 삭제 </button>
        </div>
    </div>
    <div>
        <pre>{{comment}}</pre>
    </div>
</section>

<footer>
    <div>
        <a href ="/">목록으로</a>
    </div>
</footer>